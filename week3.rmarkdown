# Model definition (Weight)

$$
\begin{align}
weight_i &\sim \text{Normal}(\mu, \sigma) \\
\mu &\sim \text{Normal}(50, 10) \\
\sigma &\sim \text{Uniform}(0, 50)
\end{align}
$$

```{r, message=FALSE, results="hide"}
set.seed(101)
model <- ulam(
  alist(
    weight ~ normal(mu, sigma),
    mu ~ normal(50, 10),
    sigma ~ uniform(0, 50)
  ),
  data = df_weight
)
```
```{r}
precis(model, prob = 0.95)
```


# Model (Weight ~ Sex)
$$
\begin{align}
\text{weight}_i &\sim \text{Normal}(\mu_i, \sigma) \\
\mu_i &= \alpha_{sex[i]} \\
\alpha_{sex} &\sim \text{Normal}(50, 10) \\
\sigma &\sim \text{Uniform}(0, 50)
\end{align}
$$

```{r, message=FALSE, results="hide"}
set.seed(101)
model <- ulam(
  alist(
    weight ~ normal(mu, sigma),
    mu <- a[sex],
    a[sex] ~ normal(50, 10),
    sigma ~ uniform(0, 50)
  ),
  data = df_weight
)
```
```{r}
precis(model, prob = 0.95, depth=2)
```


# Model (Weight ~ Height)

$$
\begin{align}
\text{weight}_i &\sim \text{Normal}(\mu_i, \sigma) \\
\mu_i &= \alpha + \beta\times \text{height}_i \\
\alpha &\sim \text{Normal}(50, 10) \\
\beta &\sim \text{Normal}(0, 10) \\
\sigma &\sim \text{Uniform}(0, 50)
\end{align}
$$

```{r, message=FALSE, results="hide"}
set.seed(101)
model <- ulam(
  alist(
    weight ~ normal(mu, sigma),
    mu <- a + b * height_std,
    a ~ normal(50, 10),
    b ~ normal(0, 10),
    sigma ~ uniform(0, 50)
  ),
  data = df_weight
)
```

```{r}
precis(model, prob = 0.95)
```

# Model (Weight ~ Sex + Height)

$$
\begin{align}
\text{weight}_i &\sim \text{Normal}(\mu_i, \sigma) \\
\mu_i &= \alpha_{sex[i]} + \beta\times \text{height}_i \\
\alpha_{sex[i]} &\sim \text{Normal}(50, 10) \\
\beta &\sim \text{Normal}(0, 10) \\
\sigma &\sim \text{Uniform}(0, 50)
\end{align}
$$

```{r, message=FALSE, results="hide"}
set.seed(101)
model <- ulam(
  alist(
    weight ~ normal(mu, sigma),
    mu <- a[sex] + b * height_std,
    a[sex] ~ normal(50, 10),
    b ~ normal(0, 10),
    sigma ~ uniform(0, 50)
  ),
  data = df_weight
)
```

```{r}
precis(model, prob = 0.95, depth = 2)
```

# Model (Fertility ~ Women in College)
```{r, message=FALSE, results="hide"}
model1a <- cmdstan_model("models/wb_model1a.stan")
fit1a <- df |>
  transmute(
    fertility_rate = SP.DYN.TFRT.IN,
    women_in_college = scale(SE.TER.ENRR.FE) |> as.numeric()
  ) |>
  drop_na() |>
  compose_data() |>
  model1a$sample(chains=1)

fit1a$output()

fit1a |>
  spread_draws(alpha, beta, sigma) |>
  ggplot(aes(x = beta)) +
  stat_halfeye()

fit1a |>
  spread_draws(alpha, beta, sigma) |>
  mutate(
    r2 = beta^2 / (beta^2 + sigma^2)
  ) |>
  summarise(
    r2_mean = mean(r2),
    r2_median = median(r2),
    r2_q05 = quantile(r2, 0.05),
    r2_q95 = quantile(r2, 0.95)
  )
```

```{r}
fit1a$summary()
```


