# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Build output and caches. Locally .quarto and .stancache are symlinks to *.nosync
# dirs (see _build/nosync.sh); on CI they are real dirs. The site renders straight
# into .output.nosync (see _quarto.yml); /.output is the old output dir.
/.quarto
/_extensions/
/.stancache
*.nosync
/.output

**/*.quarto_ipynb

# Compiled theme CSS: Quarto rebuilds it from css/deck.scss on every render and names it
# by content hash, so every theme edit would otherwise leave another copy in _freeze
_freeze/site_libs/revealjs/dist/theme/quarto-*.css

# Stray output: R's default graphics device, and rendering a single file outside the
# project (which writes next to the source instead of into .output.nosync/)
Rplots.pdf
/*.html
/*_files/
/site_libs/

# Homework answer keys: the repo is public, so keep them out of it
homework/*_key.md

# OS and local tool settings
.DS_Store
# iCloud Drive conflict copies ("week1 2.html", "site_libs 3/")
* [0-9]
* [0-9].*
.claude/settings.local.json

/.quarto/
